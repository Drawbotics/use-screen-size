{
  "name": "@drawbotics/use-screen-size",
  "version": "3.1.1",
  "description": "Hook used to get the current screen size for responsive behaviour",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "author": "Nicolaos Moscholios <nick@drawbotics.com>",
  "license": "UNLICENSED",
  "scripts": {
    "clean": "rm -rf lib/",
    "build": "NODE_ENV=production babel src --out-dir lib/ --ignore 'src/__tests__' && cp src/index.d.ts lib/",
    "test:watch": "BABEL_ENV=test jest --watch",
    "prepublishOnly": "npm run clean && npm test && npm run build",
    "test": "jest",
    "prepare": "husky"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drawbotics/use-screen-size.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --format node_modules/eslint-formatter-pretty/index.js --max-warnings=0"
  },
  "peerDependencies": {
    "@drawbotics/drylus-style-vars": ">=8.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.6.0",
    "@babel/core": "^7.6.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@drawbotics/drylus-style-vars": "^8.7.30",
    "@eslint/js": "^9.28.0",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^30.3.0",
    "eslint": "^9.39.3",
    "eslint-formatter-pretty": "^7.0.0",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
